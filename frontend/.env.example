# Deployed HarvestEscrow address on BNB Smart Chain Testnet (chain 97).
VITE_CONTRACT_ADDRESS=

# BNB Smart Chain Testnet RPC.
VITE_BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Chain id. Resolution order in src/config/chain.js: this value wins if set;
# else a localhost/127.0.0.1 RPC means Anvil 31337; else the default is 97.
# REQUIRED for the opBNB Testnet deployment: set VITE_CHAIN_ID=5611. If left
# unset with a non-localhost RPC, the frontend resolves to 97 and every write
# fails with a chain mismatch.
VITE_CHAIN_ID=

# Off-chain AI agent HTTP API.
VITE_AGENT_URL=http://localhost:8787

# WalletConnect Cloud project id (https://cloud.reown.com). Required for the
# WalletConnect QR option; injected wallets work without it.
VITE_WALLETCONNECT_PROJECT_ID=
