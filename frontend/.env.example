# Deployed HarvestEscrow address on opBNB Testnet (chain 5611).
VITE_CONTRACT_ADDRESS=

# RPC for the chain above. The name is historical: opBNB Testnet by default.
# For BNB Testnet (97) use https://data-seed-prebsc-1-s1.bnbchain.org:8545.
VITE_BNB_TESTNET_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org

# Chain id. Resolution order in src/config/chain.js: this value wins if set;
# else a localhost/127.0.0.1 RPC means Anvil 31337; else the fallback is 97.
# Must match VITE_BNB_TESTNET_RPC_URL. Left unset against the opBNB RPC above,
# the frontend resolves to 97 and every write fails with a chain mismatch.
VITE_CHAIN_ID=5611

# Off-chain AI agent HTTP API.
VITE_AGENT_URL=http://localhost:8787

# WalletConnect Cloud project id (https://cloud.reown.com). Required for the
# WalletConnect QR option; injected wallets work without it.
VITE_WALLETCONNECT_PROJECT_ID=
