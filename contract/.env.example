# Deployer / contract owner wallet. Holds tBNB for gas + escrow deploys.
PRIVATE_KEY=

# Trusted AI agent oracle wallet. Only this address can post AI results on-chain.
ORACLE_ADDRESS=

# Oracle wallet private key. Server-side only. NEVER expose to the frontend.
ORACLE_PRIVATE_KEY=

# Optional: a test wallet for simulating buyer/farmer in scripts.
TESTUSER_ADDRESS=
TESTUSER_PRIVATE_KEY=

# opBNB Testnet (chain 5611) — the chain this project is deployed on.
OPBNB_TESTNET_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
CHAIN_ID=5611

# BNB Smart Chain Testnet (chain 97) — alternative target.
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Explorer API key, needed for --verify only (https://etherscan.io/myapikey).
# BscScan serves opBNB Testnet too: https://opbnb-testnet.bscscan.com
BSCSCAN_API_KEY=
